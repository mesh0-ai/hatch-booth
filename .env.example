# The Hatch deployment this dashboard drives.
VITE_HATCH_URL=https://hatch.mesh0.ai

# The staff token, matching HATCH_STAFF_TOKEN on that deployment.
#
# Vite INLINES this into the bundle at build time. That is why this app is run
# locally with `npm run dev` and is never hosted: on a public origin an inlined
# token is a published token, and this token is the whole of the
# authentication — it mints Xano impersonation tokens and starts deploys.
#
# Generate on the Hatch side with `openssl rand -hex 32` and paste the same
# value here. Revoked by redeploying Hatch with a new one.
VITE_HATCH_STAFF_TOKEN=
